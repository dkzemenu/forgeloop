---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- HERO -->
	<section class="hero">
		<!-- animated background layers -->
		<div class="hero-noise"></div>
		<div class="hero-orb hero-orb-1"></div>
		<div class="hero-orb hero-orb-2"></div>
		<div class="hero-orb hero-orb-3"></div>
		<div class="hero-orb hero-orb-4"></div>

		<div class="hero-inner">
			<div class="hero-eyebrow">
				<span class="eyebrow-pip"></span>
				Washington DC &amp; Addis Ababa
			</div>

			<h1>We build<br /><span class="outline">software</span><br />that matters.</h1>

			<p class="hero-sub">
				Outsourced engineering and local solutions for businesses in the US and Ethiopia —
				delivered with precision.
			</p>

			<div class="hero-cta">
				<a href="#contact" class="btn btn-primary">Start a project</a>
				<a
					href="#services"
					class="btn btn-secondary"
					style="background:hsl(0 0% 10%); color:hsl(0 0% 65%); border: 1px solid hsl(0 0% 16%);"
					>View services</a
				>
			</div>

			<div class="hero-meta">
				<div class="meta-item">
					<span class="meta-flag">🇺🇸</span>
					<span>United States</span>
				</div>
				<div class="meta-sep"></div>
				<div class="meta-item">
					<span class="meta-flag">🇪🇹</span>
					<span>Ethiopia</span>
				</div>
			</div>
		</div>
	</section>

	<!-- TICKER -->
	<div class="ticker">
		<div class="ticker-track">
			<span class="ticker-item">Outsourced Development</span><span class="ticker-dot"></span>
			<span class="ticker-item">Custom Engineering</span><span class="ticker-dot"></span>
			<span class="ticker-item">AI &amp; Automation</span><span class="ticker-dot"></span>
			<span class="ticker-item">Cloud &amp; DevOps</span><span class="ticker-dot"></span>
			<span class="ticker-item">Ethiopian Market Solutions</span><span class="ticker-dot"></span>
			<span class="ticker-item">Technical Consulting</span><span class="ticker-dot"></span>
			<span class="ticker-item">Mobile &amp; Web</span><span class="ticker-dot"></span>
			<!-- duplicate for seamless loop -->
			<span class="ticker-item">Outsourced Development</span><span class="ticker-dot"></span>
			<span class="ticker-item">Custom Engineering</span><span class="ticker-dot"></span>
			<span class="ticker-item">AI &amp; Automation</span><span class="ticker-dot"></span>
			<span class="ticker-item">Cloud &amp; DevOps</span><span class="ticker-dot"></span>
			<span class="ticker-item">Ethiopian Market Solutions</span><span class="ticker-dot"></span>
			<span class="ticker-item">Technical Consulting</span><span class="ticker-dot"></span>
			<span class="ticker-item">Mobile &amp; Web</span><span class="ticker-dot"></span>
		</div>
	</div>

	<!-- SERVICES -->
	<section id="services">
		<div class="container">
			<div class="services-layout">
				<div class="sticky-col">
					<div class="section-label">What we do</div>
					<h2 class="h2">Built for<br />real results.</h2>
					<p class="lead">
						From embedded engineering teams to market-specific local products — we handle the
						full cycle.
					</p>
					<a href="#contact" class="btn btn-brand">Work with us</a>
				</div>

				<div class="service-list">
					<div class="service-row">
						<span class="svc-num">01</span>
						<div>
							<div class="svc-title">Outsourced Software Development</div>
							<div class="svc-desc">
								We embed directly into your team — managing your backlog, shipping on schedule,
								and keeping everything visible. No handoffs, no black boxes.
							</div>
						</div>
					</div>
					<div class="service-row">
						<span class="svc-num">02</span>
						<div>
							<div class="svc-title">Custom Software Engineering</div>
							<div class="svc-desc">
								Web apps, mobile apps, APIs, and backend systems built from first principles for
								your business logic and designed to scale.
							</div>
						</div>
					</div>
					<div class="service-row">
						<span class="svc-num">03</span>
						<div>
							<div class="svc-title">Local Solutions — Ethiopia</div>
							<div class="svc-desc">
								Fintech, e-commerce, logistics, and civic platforms with deep knowledge of
								Ethiopian market dynamics, payment rails, and regulatory context.
							</div>
						</div>
					</div>
					<div class="service-row">
						<span class="svc-num">04</span>
						<div>
							<div class="svc-title">AI &amp; Intelligent Automation</div>
							<div class="svc-desc">
								LLM integrations, workflow automation, and data pipelines that reduce friction
								and give your team serious leverage.
							</div>
						</div>
					</div>
					<div class="service-row">
						<span class="svc-num">05</span>
						<div>
							<div class="svc-title">Cloud &amp; DevOps</div>
							<div class="svc-desc">
								Infrastructure, CI/CD, containerisation, and cloud migrations on AWS, GCP, and
								Azure — so your product stays reliable and your team moves fast.
							</div>
						</div>
					</div>
					<div class="service-row">
						<span class="svc-num">06</span>
						<div>
							<div class="svc-title">Technical Consulting</div>
							<div class="svc-desc">
								Architecture reviews, due diligence, and technology roadmaps for founders and
								engineering leaders who need a trusted second opinion.
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section id="about">
		<div class="container">
			<div class="about-grid">
				<div class="loc-card-pair">
					<div class="loc-panel">
						<span class="loc-flag">🇺🇸</span>
						<div class="loc-region">North America</div>
						<div class="loc-city">Washington DC</div>
						<div class="loc-note">
							Serving US clients with enterprise-grade development, product strategy, and
							technical consulting.
						</div>
					</div>
					<div class="loc-panel">
						<span class="loc-flag">🇪🇹</span>
						<div class="loc-region">East Africa</div>
						<div class="loc-city">Addis Ababa</div>
						<div class="loc-note">
							Building platforms for Ethiopian businesses, startups, and institutions with local
							market expertise.
						</div>
					</div>
				</div>

				<div class="about-copy">
					<div class="section-label">Who we are</div>
					<h2 class="h2">Two markets.<br />One team.</h2>
					<p class="lead">
						ForgeLoop bridges world-class engineering and the markets that need it most —
						combining US rigour with deep knowledge of Ethiopia's fast-growing tech landscape.
					</p>
					<p class="lead">We don't measure success in hours billed. We measure it in outcomes shipped.</p>
					<ul class="checklist">
						<li>
							<span class="check-icon">
								<svg width="8" height="8" viewBox="0 0 8 8" fill="none"
									><path
										d="M1.5 4L3.5 6L6.5 2"
										stroke="white"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							Senior engineers only — no juniors on your product
						</li>
						<li>
							<span class="check-icon">
								<svg width="8" height="8" viewBox="0 0 8 8" fill="none"
									><path
										d="M1.5 4L3.5 6L6.5 2"
										stroke="white"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							Agile sprints with real, weekly visibility
						</li>
						<li>
							<span class="check-icon">
								<svg width="8" height="8" viewBox="0 0 8 8" fill="none"
									><path
										d="M1.5 4L3.5 6L6.5 2"
										stroke="white"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							Outcome-based pricing, not hourly billing
						</li>
						<li>
							<span class="check-icon">
								<svg width="8" height="8" viewBox="0 0 8 8" fill="none"
									><path
										d="M1.5 4L3.5 6L6.5 2"
										stroke="white"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							Long-term partnerships over one-off engagements
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- PROCESS -->
	<section id="process">
		<div class="container">
			<div class="section-label">How we work</div>
			<h2 class="h2" style="max-width:460px;">A process that keeps<br />you in control.</h2>

			<div class="step-grid">
				<div class="step-card">
					<span class="step-badge">01 — Discovery</span>
					<div class="step-title">Understand before we build.</div>
					<div class="step-body">
						We learn your business, users, and constraints before proposing anything. Scope,
						budget, and success metrics agreed together upfront.
					</div>
				</div>
				<div class="step-card">
					<span class="step-badge">02 — Architecture</span>
					<div class="step-title">Design for where you're going.</div>
					<div class="step-body">
						Tech stack, infrastructure, and system design locked in before production code is
						written. No expensive surprises halfway through.
					</div>
				</div>
				<div class="step-card">
					<span class="step-badge">03 — Build</span>
					<div class="step-title">Ship in two-week cycles.</div>
					<div class="step-body">
						Two-week sprints, async daily updates, continuous delivery. You see real progress
						every week — not just at the end.
					</div>
				</div>
				<div class="step-card">
					<span class="step-badge">04 — Launch</span>
					<div class="step-title">Go live with confidence.</div>
					<div class="step-body">
						We handle deployment, monitoring, and post-launch iteration. Your product doesn't
						stop at v1 — neither do we.
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- TECH STACK -->
	<section id="tech">
		<div class="container">
			<div class="tech-header">
				<div>
					<div class="section-label">Technologies</div>
					<h2 class="h2">Modern stack,<br />proven tools.</h2>
				</div>
				<p class="lead" style="font-size:0.875rem;">
					Battle-tested technologies across every layer. We pick the right tool for the job —
					not the trendy one.
				</p>
			</div>

			<div class="stack-groups">
				<div>
					<div class="stack-label">Frontend</div>
					<div class="tag-row">
						<span class="tag">React</span>
						<span class="tag">Next.js</span>
						<span class="tag">TypeScript</span>
						<span class="tag">Vue</span>
						<span class="tag">Tailwind CSS</span>
					</div>
				</div>
				<div>
					<div class="stack-label">Backend</div>
					<div class="tag-row">
						<span class="tag">Node.js</span>
						<span class="tag">Python</span>
						<span class="tag">Django</span>
						<span class="tag">FastAPI</span>
						<span class="tag">Go</span>
						<span class="tag">GraphQL</span>
						<span class="tag">REST</span>
					</div>
				</div>
				<div>
					<div class="stack-label">Mobile</div>
					<div class="tag-row">
						<span class="tag">React Native</span>
						<span class="tag">Flutter</span>
						<span class="tag">Expo</span>
					</div>
				</div>
				<div>
					<div class="stack-label">Infrastructure &amp; Data</div>
					<div class="tag-row">
						<span class="tag">AWS</span>
						<span class="tag">GCP</span>
						<span class="tag">Docker</span>
						<span class="tag">Kubernetes</span>
						<span class="tag">PostgreSQL</span>
						<span class="tag">MongoDB</span>
						<span class="tag">Redis</span>
						<span class="tag">Terraform</span>
					</div>
				</div>
				<div>
					<div class="stack-label">AI &amp; ML</div>
					<div class="tag-row">
						<span class="tag">Claude / Anthropic</span>
						<span class="tag">OpenAI</span>
						<span class="tag">LangChain</span>
						<span class="tag">Hugging Face</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section id="contact">
		<div class="container">
			<div class="cta-eyebrow">Get in touch</div>
			<h2>Ready to build<br />something real?</h2>
			<p>Tell us what you're working on. We'll reply within 24 hours with a clear, honest assessment.</p>

			<form
				name="contact"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				action="/thank-you"
				class="contact-form"
			>
				<input type="hidden" name="form-name" value="contact" />
				<p style="display:none">
					<label>Don't fill this out if you're human: <input name="bot-field" /></label>
				</p>

				<div class="field-row">
					<div>
						<label for="name">Name</label>
						<input type="text" name="name" id="name" required />
					</div>
					<div>
						<label for="email">Email</label>
						<input type="email" name="email" id="email" required />
					</div>
				</div>

				<div>
					<label for="message">Message</label>
					<textarea name="message" id="message" required></textarea>
				</div>

				<button type="submit" class="btn btn-primary">Send message</button>
			</form>

			<span class="cta-note">or reach us at <a href="mailto:hello@forgeloop.com">hello@forgeloop.com</a></span>
		</div>
	</section>
</Layout>
