---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog — ForgeLoop" description="Notes on how we build software, from ForgeLoop's teams in Washington DC and Addis Ababa.">
	<section class="blog-hero">
		<div class="container">
			<div class="section-label">Blog</div>
			<h2 class="h2">Notes from<br />the build.</h2>
		</div>
	</section>

	<section class="blog-list">
		<div class="container">
			{
				posts.length === 0 ? (
					<p class="blog-empty">No posts yet — check back soon.</p>
				) : (
					posts.map((post) => (
						<a href={`/blog/${post.id}`} class="blog-card">
							<span class="blog-date">
								{post.data.date.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</span>
							<div class="blog-card-title">{post.data.title}</div>
							<p class="blog-card-desc">{post.data.description}</p>
						</a>
					))
				)
			}
		</div>
	</section>
</Layout>
